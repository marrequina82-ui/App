# Your computer's LAN IP, so a phone on the same Wi-Fi can reach the server
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Firebase web app config: Firebase console → Project settings → Your apps → Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=yourproject.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=yourproject
EXPO_PUBLIC_FIREBASE_APP_ID=

# Social sign-in on phones (optional; on web Google/Facebook only need Firebase)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_DISCORD_CLIENT_ID=
