{
  "expo": {
    "name": "FittonesuGo!",
    "slug": "fittonesugo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sibs.fittonesugo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#047857",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sibs.fittonesugo"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#ECFDF5",
      "themeColor": "#047857"
    },
    "scheme": "fittonesugo",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "FittonesuGo uses your camera to photograph meals and nutrition labels so the AI can estimate calories.",
          "photosPermission": "FittonesuGo lets you pick a meal or label photo from your gallery."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ECFDF5",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ECFDF5"
    }
  }
}
